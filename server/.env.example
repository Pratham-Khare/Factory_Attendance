NODE_ENV=development
PORT=5000

# Local MongoDB during development OR MongoDB Atlas in production
MONGO_URI=mongodb://127.0.0.1:27017/factory-attendance

# Use a long random value (32+ characters) in production
JWT_SECRET=replace-with-a-long-random-secret

# Development: localhost is allowed automatically.
# Production: put your deployed frontend URL here.
CLIENT_URL=http://localhost:5173

FACE_MATCH_THRESHOLD=0.52
AUTH_RATE_LIMIT=30
# Optional emergency development switch only:
# ALLOW_ALL_CORS=true

# Separate kiosk/attendance login credentials (keep different from admin)
ATTENDANCE_USERNAME=attendance
ATTENDANCE_PASSWORD=change-this-to-a-strong-password

# OTP password reset email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Factory Attendance <your-email@gmail.com>

# Recovery emails. Admin can also use the email saved during first setup.
ADMIN_RESET_EMAIL=admin@example.com
ATTENDANCE_RESET_EMAIL=attendance@example.com
